# Ignore Visual Studio cache and workspace files
.vs/

# Ignore Node.js dependencies
node_modules/

# Ignore build output directories
bin/
debug/
obj/

# Ignore logs and temporary files
*.log
*.tmp

# Ignore Angular build artifacts
frontend/dist/
frontend/.angular/

# ── SECURITY: Environment variables with secrets ──
# Never commit .env files containing ADMIN_PASSWORD_HASH, ADMIN_SALT, or other secrets
.env
.env.local
.env.*.local
.env.production.local

# IDE-specific files
.idea/
*.swp
*.swo
*.swn
